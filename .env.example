# Optional URL of a running deluge-web instance (JSON-RPC at /json).
# Include protocol and port, e.g. http://192.168.1.10:8112
# Leave unset (or set DELUGE_DEMO=1) to use the in-memory demo backend.
DELUGE_WEB_URL=

# Force Deluge demo mode even if DELUGE_WEB_URL is set.
DELUGE_DEMO=

# Allow self-signed TLS certificates when proxying to deluge-web.
DELUGE_TLS_INSECURE=

# Optional Transmission RPC URL, e.g. http://127.0.0.1:9091/transmission/rpc
# Leave unset (or set TRANSMISSION_DEMO=1) to use the in-memory Transmission demo.
TRANSMISSION_RPC_URL=

# Force Transmission demo mode even if TRANSMISSION_RPC_URL is set.
TRANSMISSION_DEMO=

# Allow self-signed TLS certificates when proxying to Transmission RPC.
TRANSMISSION_TLS_INSECURE=
